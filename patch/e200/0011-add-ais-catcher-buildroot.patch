new file mode 100644
--- /dev/null
+++ b/package/ais-catcher/ais-catcher.default
@@ -0,0 +1,13 @@
+# E200 on-board AIS receiver defaults. Override persistently with
+# /mnt/jffs2/ais-catcher.default.
+AIS_URI="local:"
+# AB listens to AIS 1 (161.975 MHz) and AIS 2 (162.025 MHz), centered at
+# 162.000 MHz by AIS-catcher.
+AIS_SAMPLE_RATE="3840000"
+AIS_RF_BANDWIDTH="1000000"
+AIS_GAIN="50"
+AIS_CHANNELS="AB"
+AIS_NMEA_PORT="10110"
+AIS_WEB_PORT="8100"
+AIS_EXCLUSIVE_IIO="1"
+AIS_EXTRA_ARGS=""
diff --git a/package/ais-catcher/ais-watchdog b/package/ais-catcher/ais-watchdog
new file mode 100644
--- /dev/null
+++ b/package/ais-catcher/ais-watchdog
@@ -0,0 +1,24 @@
+#!/bin/sh
+set -u
+. /etc/default/ais-catcher
+[ -r /mnt/jffs2/ais-catcher.default ] && . /mnt/jffs2/ais-catcher.default
+child_pid=""
+stop_child() {
+	trap - TERM INT
+	if [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
+		kill "$child_pid" 2>/dev/null || true
+		wait "$child_pid" 2>/dev/null || true
+	fi
+	exit 0
+}
+trap stop_child TERM INT
+while :; do
+	/usr/bin/AIS-catcher \
+		-j "$AIS_URI" -s "$AIS_SAMPLE_RATE" -a "$AIS_RF_BANDWIDTH" \
+		-c "$AIS_CHANNELS" -gI GAIN "$AIS_GAIN" \
+		-S "$AIS_NMEA_PORT" -N "$AIS_WEB_PORT" -o 1 $AIS_EXTRA_ARGS &
+	child_pid=$!
+	wait "$child_pid" || true
+	child_pid=""
+	sleep 1
+done
diff --git a/package/ais-catcher/ais-service b/package/ais-catcher/ais-service
new file mode 100644
--- /dev/null
+++ b/package/ais-catcher/ais-service
@@ -0,0 +1,41 @@
+#!/bin/sh
+DAEMON=/usr/sbin/ais-watchdog
+PIDFILE=/var/run/ais-watchdog.pid
+. /etc/default/ais-catcher
+[ -r /mnt/jffs2/ais-catcher.default ] && . /mnt/jffs2/ais-catcher.default
+stop_iiod() {
+	[ "${AIS_EXCLUSIVE_IIO:-1}" = 1 ] || return 0
+	[ -s /var/run/iiod.pid ] || return 0
+	start-stop-daemon -K -q -p /var/run/iiod.pid -x /usr/sbin/iiod 2>/dev/null || true
+	rm -f /var/run/iiod.pid
+}
+start_iiod() {
+	[ "${AIS_EXCLUSIVE_IIO:-1}" = 1 ] || return 0
+	[ -s /var/run/iiod.pid ] && kill -0 "$(cat /var/run/iiod.pid)" 2>/dev/null && return 0
+	[ -r /etc/device_config ] && . /etc/device_config
+	start-stop-daemon -S -b -q -m -p /var/run/iiod.pid -x /usr/sbin/iiod -- -D -n "${ENDPOINTS:-1}" -F /dev/iio_ffs
+}
+running() { [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
+case "${1:-}" in
+	start)
+		printf 'Starting E200 AIS decoder: '
+		running && { echo already running; exit 0; }
+		stop_iiod
+		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"
+		sleep 1
+		running && { echo OK; exit 0; }
+		echo FAIL; start_iiod; exit 1 ;;
+	stop)
+		printf 'Stopping E200 AIS decoder: '
+		if running; then
+			start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null || true
+			n=0
+			while running && [ "$n" -lt 5 ]; do sleep 1; n=$((n + 1)); done
+		fi
+		rm -f "$PIDFILE"; start_iiod; echo OK ;;
+	status)
+		running && { echo "AIS: on (PID $(cat "$PIDFILE"), NMEA $AIS_NMEA_PORT, web $AIS_WEB_PORT)"; exit 0; }
+		echo "AIS: off"; exit 3 ;;
+	restart|reload) "$0" stop; sleep 1; "$0" start ;;
+	*) echo "Usage: $0 {start|stop|status|restart|reload}"; exit 1 ;;
+esac
diff --git a/package/ais-catcher/ais-control b/package/ais-catcher/ais-control
new file mode 100644
--- /dev/null
+++ b/package/ais-catcher/ais-control
@@ -0,0 +1,8 @@
+#!/bin/sh
+case "${1:-}" in
+	on) exec /usr/sbin/ais-service start ;;
+	off) exec /usr/sbin/ais-service stop ;;
+	status) exec /usr/sbin/ais-service status ;;
+	restart) exec /usr/sbin/ais-service restart ;;
+	*) echo "Usage: ais-control {on|off|status|restart}"; exit 1 ;;
+esac
