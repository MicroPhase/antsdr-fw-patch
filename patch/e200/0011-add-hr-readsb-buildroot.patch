 [ -n "${READSB_LAT:-}" ] && readsb_args="$readsb_args --lat=$READSB_LAT"
 [ -n "${READSB_LON:-}" ] && readsb_args="$readsb_args --lon=$READSB_LON"
 readsb_args="$readsb_args ${READSB_EXTRA_ARGS:-}"
