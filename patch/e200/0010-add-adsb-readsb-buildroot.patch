diff --git a/package/readsb/Config.in b/package/readsb/Config.in
new file mode 100644
index 0000000000..121e2decd3
--- /dev/null
+++ b/package/readsb/Config.in
@@ -0,0 +1,14 @@
+config BR2_PACKAGE_READSB
+	bool "readsb ADS-B decoder"
+	depends on BR2_TOOLCHAIN_HAS_THREADS
+	select BR2_PACKAGE_LIBIIO
+	select BR2_PACKAGE_LIBAD9361_IIO
+	select BR2_PACKAGE_ZSTD
+	help
+	  readsb Mode-S/ADS-B decoder using the local AD936x IIO device.
+	  The E200 image runs it on the board and exposes Beast TCP on port
+	  30005, JSON position events on port 8081, and the readsb HTTP API
+	  on port 8080 over Ethernet.
+
+comment "readsb needs a toolchain w/ threads"
+	depends on !BR2_TOOLCHAIN_HAS_THREADS
diff --git a/package/readsb/readsb.mk b/package/readsb/readsb.mk
new file mode 100644
index 0000000000..acfa65c5d6
--- /dev/null
+++ b/package/readsb/readsb.mk
@@ -0,0 +1,44 @@
+################################################################################
+#
+# readsb ADS-B decoder
+#
+################################################################################
+
+READSB_VERSION = d9a4c62655490e70d07704e207738bb9c6cffde1
+READSB_SITE = https://github.com/wiedehopf/readsb.git
+READSB_SITE_METHOD = git
+READSB_GIT_SUBMODULES = NO
+READSB_LICENSE = GPL-3.0+
+READSB_LICENSE_FILES = COPYING
+READSB_DEPENDENCIES = libiio libad9361-iio zstd
+
+# This upstream revision stores sdr_plutosdr.c with CRLF line endings.
+# Normalize it so the E200 patch is reproducible through the parent patch set.
+define READSB_NORMALIZE_PLUTOSDR_LINE_ENDINGS
+	$(SED) 's/\r$$//' $(@D)/sdr_plutosdr.c
+endef
+READSB_POST_EXTRACT_HOOKS += READSB_NORMALIZE_PLUTOSDR_LINE_ENDINGS
+
+# The upstream Makefile has no configure step.  Disable the interactive
+# ncurses UI because the E200 image is headless, and select the Pluto/IIO
+# backend.  Keep only CPU/ABI flags in OPTIMIZE: TARGET_CFLAGS also contains
+# Buildroot's _FORTIFY_SOURCE definition, while readsb sets its own value.
+READSB_CPU_FLAGS = -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard
+define READSB_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) \
+		CC="$(TARGET_CC)" AR="$(TARGET_AR)" \
+		PLUTOSDR=yes DISABLE_INTERACTIVE=yes \
+		OPTIMIZE="$(READSB_CPU_FLAGS)"
+endef
+
+define READSB_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/readsb $(TARGET_DIR)/usr/bin/readsb
+	$(INSTALL) -D -m 0755 $(READSB_PKGDIR)/S90readsb $(TARGET_DIR)/etc/init.d/S90readsb
+	$(INSTALL) -D -m 0755 $(READSB_PKGDIR)/readsb-service $(TARGET_DIR)/usr/sbin/readsb-service
+	$(INSTALL) -D -m 0755 $(READSB_PKGDIR)/adsb-control $(TARGET_DIR)/usr/sbin/adsb-control
+	$(INSTALL) -D -m 0755 $(READSB_PKGDIR)/S22adsb-storage $(TARGET_DIR)/etc/init.d/S22adsb-storage
+	$(INSTALL) -D -m 0755 $(READSB_PKGDIR)/readsb-watchdog $(TARGET_DIR)/usr/sbin/readsb-watchdog
+	$(INSTALL) -D -m 0644 $(READSB_PKGDIR)/readsb.default $(TARGET_DIR)/etc/default/readsb
+	mkdir -p $(TARGET_DIR)/var/run/readsb
+endef
+
+$(eval $(generic-package))
