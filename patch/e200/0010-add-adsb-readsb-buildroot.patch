diff --git a/package/readsb/readsb.default b/package/readsb/readsb.default
new file mode 100644
index 0000000000..fb24e050e3
--- /dev/null
+++ b/package/readsb/readsb.default
@@ -0,0 +1,14 @@
+# E200 on-board ADS-B decoder defaults.
+# Override this file in /mnt/jffs2/readsb.default for a persistent setup.
+READSB_FREQ="1090000000"
+READSB_GAIN="50"
+READSB_PREAMBLE_THRESHOLD="58"
+READSB_LAT=""
+READSB_LON=""
+READSB_STALE_AFTER="20"
+READSB_WATCH_INTERVAL="5"
+READSB_BEAST_PORT="30005"
+READSB_API_PORT="8080"
+READSB_JSON_PORT="8081"
+READSB_EXCLUSIVE_IIO="1"
+READSB_LOGFILE="/mnt/sdcard/adsb/readsb.log"
+READSB_LOG_MAX_BYTES="8388608"
+READSB_LOG_BACKUPS="4"
+READSB_EXTRA_ARGS=""
diff --git a/package/readsb/readsb-service b/package/readsb/readsb-service
new file mode 100644
index 0000000000..fd8a192400
--- /dev/null
+++ b/package/readsb/readsb-service
@@ -0,0 +1,79 @@
+#!/bin/sh
+
+DAEMON=/usr/sbin/readsb-watchdog
+PIDFILE=/var/run/readsb-watchdog.pid
+
+[ -r /etc/default/readsb ] && . /etc/default/readsb
+
+stop_iiod() {
+	[ "${READSB_EXCLUSIVE_IIO:-1}" = 1 ] || return 0
+	if [ -s /var/run/iiod.pid ]; then
+		start-stop-daemon -K -q -p /var/run/iiod.pid -x /usr/sbin/iiod 2>/dev/null || true
+		for _wait in 1 2 3 4 5; do
+			kill -0 "$(cat /var/run/iiod.pid)" 2>/dev/null || break
+			sleep 1
+		done
+		rm -f /var/run/iiod.pid
+	fi
+}
+
+start_iiod() {
+	[ "${READSB_EXCLUSIVE_IIO:-1}" = 1 ] || return 0
+	if [ -s /var/run/iiod.pid ] && kill -0 "$(cat /var/run/iiod.pid)" 2>/dev/null; then
+		return 0
+	fi
+	[ -r /etc/device_config ] && . /etc/device_config
+	start-stop-daemon -S -b -q -m -p /var/run/iiod.pid -x /usr/sbin/iiod -- \
+		-D -n "${ENDPOINTS:-1}" -F /dev/iio_ffs
+}
+
+adsb_running() {
+	[ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
+}
+
+case "$1" in
+	start)
+		printf 'Starting E200 ADS-B decoder: '
+		if adsb_running; then
+			echo already running
+			exit 0
+		fi
+		stop_iiod
+		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"
+		sleep 1
+		if adsb_running; then echo OK; else echo FAIL; start_iiod; exit 1; fi
+		;;
+	stop)
+		printf 'Stopping E200 ADS-B decoder: '
+		if adsb_running; then
+			pid=$(cat "$PIDFILE")
+			kill "$pid" 2>/dev/null || true
+			for _wait in 1 2 3 4 5; do
+				kill -0 "$pid" 2>/dev/null || break
+				sleep 1
+			done
+			kill -KILL "$pid" 2>/dev/null || true
+		fi
+		rm -f "$PIDFILE"
+		start_iiod
+		echo OK
+		;;
+	status)
+		if adsb_running; then
+			echo "ADS-B: on (readsb watchdog PID $(cat "$PIDFILE"))"
+			exit 0
+		fi
+		if [ -s /var/run/iiod.pid ] && kill -0 "$(cat /var/run/iiod.pid)" 2>/dev/null; then
+			echo "ADS-B: off (iiod PID $(cat /var/run/iiod.pid))"
+		else
+			echo "ADS-B: off (iiod is not running)"
+		fi
+		exit 3
+		;;
+	restart|reload)
+		"$0" stop
+		sleep 1
+		"$0" start
+		;;
+	*) echo "Usage: $0 {start|stop|status|restart|reload}"; exit 1 ;;
+esac
diff --git a/package/readsb/adsb-control b/package/readsb/adsb-control
new file mode 100644
index 0000000000..e3bdee6e63
--- /dev/null
+++ b/package/readsb/adsb-control
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+SERVICE=/usr/sbin/readsb-service
+
+case "${1:-}" in
+	on|start|enable)
+		exec "$SERVICE" start
+		;;
+	off|stop|disable)
+		exec "$SERVICE" stop
+		;;
+	status)
+		exec "$SERVICE" status
+		;;
+	restart)
+		exec "$SERVICE" restart
+		;;
+	*)
+		echo "Usage: adsb-control {on|off|status|restart}"
+		echo "ADS-B starts automatically at boot and can be controlled manually."
+		exit 1
+		;;
+esac
diff --git a/package/readsb/readsb-watchdog b/package/readsb/readsb-watchdog
new file mode 100644
index 0000000000..7aadfb84e3
--- /dev/null
+++ b/package/readsb/readsb-watchdog
@@ -0,0 +1,78 @@
+#!/bin/sh
+set -eu
+
+PIDFILE=/var/run/readsb-watchdog.pid
+RUNTIME=/var/run/readsb
+
+[ -r /etc/default/readsb ] && . /etc/default/readsb
+[ -r /mnt/jffs2/readsb.default ] && . /mnt/jffs2/readsb.default
+
+LOGFILE=${READSB_LOGFILE:-/var/log/readsb.log}
+if ! mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null; then
+	LOGFILE=/var/log/readsb.log
+	mkdir -p "$(dirname "$LOGFILE")"
+fi
+
+mkdir -p "$RUNTIME"
+echo $$ > "$PIDFILE"
+
+readsb_args="--device-type plutosdr --quiet --net --net-bind-address=0.0.0.0"
+readsb_args="$readsb_args --freq=$READSB_FREQ --gain=$READSB_GAIN"
+readsb_args="$readsb_args --preamble-threshold=$READSB_PREAMBLE_THRESHOLD"
+readsb_args="$readsb_args --net-bo-port=$READSB_BEAST_PORT --net-api-port=$READSB_API_PORT"
+readsb_args="$readsb_args --net-json-port=$READSB_JSON_PORT --write-json=$RUNTIME --write-json-every=1"
+[ -n "${READSB_LAT:-}" ] && readsb_args="$readsb_args --lat=$READSB_LAT"
+[ -n "${READSB_LON:-}" ] && readsb_args="$readsb_args --lon=$READSB_LON"
+readsb_args="$readsb_args ${READSB_EXTRA_ARGS:-}"
+
+child=""
+cleanup() {
+	[ -n "$child" ] && kill "$child" 2>/dev/null || true
+	rm -f "$PIDFILE"
+}
+terminate() {
+	cleanup
+	trap - EXIT
+	exit 0
+}
+trap cleanup EXIT
+trap terminate INT TERM
+
+rotate_log() {
+	max_bytes=${READSB_LOG_MAX_BYTES:-8388608}
+	backups=${READSB_LOG_BACKUPS:-4}
+	[ -f "$LOGFILE" ] || return 0
+	size=$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)
+	[ "$size" -ge "$max_bytes" ] || return 0
+	[ "$backups" -ge 1 ] || { : > "$LOGFILE"; return 0; }
+	index=$backups
+	while [ "$index" -gt 1 ]; do
+		previous=$((index - 1))
+		[ -f "${LOGFILE}.${previous}" ] && mv -f "${LOGFILE}.${previous}" "${LOGFILE}.${index}"
+		index=$previous
+	done
+	cp -f "$LOGFILE" "${LOGFILE}.1"
+	: > "$LOGFILE"
+}
+
+while :; do
+	rotate_log
+	: >> "$LOGFILE"
+	# shellcheck disable=SC2086
+	/usr/bin/readsb $readsb_args >>"$LOGFILE" 2>&1 &
+	child=$!
+	while kill -0 "$child" 2>/dev/null; do
+		sleep "${READSB_WATCH_INTERVAL:-5}"
+		rotate_log
+		mtime=$(date -r "$RUNTIME/aircraft.json" +%s 2>/dev/null || echo 0)
+		now=$(date +%s)
+		if [ "$mtime" -gt 0 ] && [ $((now - mtime)) -gt "${READSB_STALE_AFTER:-20}" ]; then
+			echo "readsb watchdog: stale aircraft.json, restarting" >>"$LOGFILE"
+			kill -TERM "$child" 2>/dev/null || true
+			break
+		fi
+	done
+	wait "$child" 2>/dev/null || true
+	child=""
+	sleep 1
+done
diff --git a/package/readsb/S22adsb-storage b/package/readsb/S22adsb-storage
new file mode 100644
index 0000000000..6666666666
--- /dev/null
+++ b/package/readsb/S22adsb-storage
@@ -0,0 +1,31 @@
+#!/bin/sh
+
+MOUNTPOINT=/mnt/sdcard
+DEVICE=/dev/mmcblk0p1
+
+mounted() {
+	grep -qs " $MOUNTPOINT " /proc/mounts
+}
+
+case "$1" in
+	start)
+		mkdir -p "$MOUNTPOINT"
+		if ! mounted && [ -b "$DEVICE" ]; then
+			mount -t vfat -o rw "$DEVICE" "$MOUNTPOINT" 2>/dev/null || \
+			mount "$DEVICE" "$MOUNTPOINT" 2>/dev/null || true
+		fi
+		if mounted; then
+			mkdir -p "$MOUNTPOINT/adsb"
+			chmod 0755 "$MOUNTPOINT/adsb"
+			echo "ADS-B storage mounted at $MOUNTPOINT"
+		else
+			echo "ADS-B storage: $DEVICE is not available; using volatile log fallback"
+		fi
+		;;
+	stop|restart|reload)
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart|reload}"
+		exit 1
+		;;
+esac
