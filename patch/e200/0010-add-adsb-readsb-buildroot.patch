diff --git a/package/readsb/0001-e200-s12-iq-format.patch b/package/readsb/0001-e200-s12-iq-format.patch
new file mode 100644
index 0000000000..cb8c337f0a
--- /dev/null
+++ b/package/readsb/0001-e200-s12-iq-format.patch
@@ -0,0 +1,61 @@
+diff --git a/sdr_plutosdr.c b/sdr_plutosdr.c
+index 7805a3b..e200ad5 100644
+--- a/sdr_plutosdr.c
++++ b/sdr_plutosdr.c
+@@ -138,6 +138,24 @@
+     if (!PLUTOSDR.rx0_q)
+         PLUTOSDR.rx0_q = iio_device_find_channel(PLUTOSDR.dev, "altvoltage1", false);
+ 
++    if (!PLUTOSDR.rx0_i || !PLUTOSDR.rx0_q) {
++        fprintf(stderr, "plutosdr: RX I/Q channels not found\n");
++        plutosdrClose();
++        return false;
++    }
++
++    // ANTSDR/E200 exposes signed 12-bit samples in 16-bit containers
++    // (libiio format le:S12/16). Use the Q11 converter so ADC full-scale is
++    // interpreted correctly; ordinary Pluto SC16 remains supported.
++    const struct iio_data_format *fmt = iio_channel_get_data_format(PLUTOSDR.rx0_i);
++    if (fmt && fmt->is_signed && fmt->bits == 12) {
++        PLUTOSDR.input_format = INPUT_SC16Q11;
++        fprintf(stderr, "plutosdr: detected S12/%u format, using SC16Q11 converter\n", fmt->length);
++    } else {
++        PLUTOSDR.input_format = INPUT_SC16;
++        fprintf(stderr, "plutosdr: detected SC16 format, using SC16 converter\n");
++    }
++
+     ad9361_set_bb_rate(iio_context_find_device(PLUTOSDR.ctx, "ad9361-phy"), Modes.sample_rate);
+ 
+     iio_channel_enable(PLUTOSDR.rx0_i);
+@@ -155,7 +173,7 @@
+         return false;
+     }
+ 
+-    PLUTOSDR.converter = init_converter(INPUT_SC16,
++    PLUTOSDR.converter = init_converter(PLUTOSDR.input_format,
+             Modes.sample_rate,
+             Modes.dc_filter,
+             &PLUTOSDR.converter_state);
+@@ -269,7 +287,21 @@
+ 
+     while (!Modes.exit) {
+         int16_t *p = PLUTOSDR.readbuf;
+-        uint32_t len = (uint32_t) iio_buffer_refill(PLUTOSDR.rxbuf) / 2;
++        ssize_t refill = iio_buffer_refill(PLUTOSDR.rxbuf);
++        if (refill < 0) {
++            static int64_t antiSpam;
++            if (mstime() > antiSpam) {
++                char error[128];
++                antiSpam = mstime() + 10 * SECONDS;
++                iio_strerror((int) -refill, error, sizeof(error));
++                fprintf(stderr, "plutosdr: IIO refill failed: %s (%d), retrying\n", error, (int) refill);
++            }
++            usleep(10000);
++            continue;
++        }
++        if (refill == 0)
++            continue;
++        uint32_t len = (uint32_t) refill / 2;
+         p_inc = iio_buffer_step(PLUTOSDR.rxbuf);
+         p_end = iio_buffer_end(PLUTOSDR.rxbuf);
+         p_dat = iio_buffer_first(PLUTOSDR.rxbuf, PLUTOSDR.rx0_i);
-- 
